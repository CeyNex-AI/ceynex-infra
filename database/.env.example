# Copy to .env in this directory on the DATABASE VM and fill in real values.
# The filled-in .env is gitignored and must never be committed.
#
# These are the credentials for the whole data tier. The backend VM's own .env
# must repeat POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / NEO4J_PASSWORD /
# REDIS_PASSWORD verbatim — they are one set of credentials seen from two
# machines, and a mismatch shows up as an authentication error in the API logs
# rather than anywhere near here.
#
# Generate them rather than inventing them:
#   openssl rand -base64 24

POSTGRES_USER=ceynex_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ceynex

NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD

REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Where the ports listen (docker-compose.yml) ---
# One VM (production): 127.0.0.1, so nothing is reachable from outside the box
# whatever the firewall says. Three VMs: leave unset (0.0.0.0, firewall-guarded).
# DB_PUBLISH_ADDR=127.0.0.1

# Volumes are named after the compose project. Production's project is `db`
# (its volumes are db_postgres_data and friends); set this so running compose
# from a directory named `database` cannot start on fresh, empty volumes.
COMPOSE_PROJECT_NAME=db
