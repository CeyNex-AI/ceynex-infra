# Copy to .env on the BACKEND VM and fill in. Never commit the filled copy.

# --- Database VM (internal IP, not the external one) ---
# gcloud compute instances describe database --zone=asia-south1-a \
#   --format='get(networkInterfaces[0].networkIP)'
DATABASE_INTERNAL_IP=10.160.0.4

# --- Credentials: must match database/.env on the database VM exactly ---
POSTGRES_USER=ceynex_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ceynex
NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Policy-document retrieval (D10) ---
# QDRANT_URL is built from DATABASE_INTERNAL_IP in docker-compose.yml, so there
# is nothing to set here for the normal case. Set this to `off` to run the
# system exactly as it behaved before retrieval existed — the state
# `make eval-policy-baseline` measures, and a valid production posture while the
# corpus is empty.
CEYNEX_POLICY_RETRIEVAL=on
QDRANT_COLLECTION=ceynex_policy

# --- News sidecar (GDELT DOC 2.0, D11) ---
# No key: GDELT DOC 2.0 is open. There is deliberately no GDELT_API_KEY line —
# a placeholder would send the next person looking for a key that does not exist.
#
# Set CEYNEX_NEWS=off if this VM cannot reach api.gdeltproject.org (it has no
# external IP, so that needs Cloud NAT). The endpoints stay up and report
# "unavailable" rather than failing, but there is no reason to spend a request
# budget discovering that on every user query.
#
# Set CEYNEX_NEWS_REFRESH=off on any replica that should serve the trending
# panel without also being the one that fetches it.
CEYNEX_NEWS=on
CEYNEX_NEWS_REFRESH=on
QDRANT_NEWS_COLLECTION=ceynex_news

# --- Auth token signing key (SRS 3.1.11) ---
# Not optional. ceynex-core falls back to a constant committed to the repo, so
# an empty value here lets anyone holding the source forge an admin token.
# Generate with:  openssl rand -hex 32
# Changing it invalidates every issued token, which is the point when rotating.
CEYNEX_JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32

# --- Purchased component (SRS 3.6.5) ---
# Model ids are in ceynex-core/config/llm.yaml, not here. Leaving this empty is
# supported: the system answers with raw knowledge-graph and forecast figures and
# sets degraded=true, which is required behaviour (SRS 3.4.3), not a failure.
OPENAI_API_KEY=

# --- R5 failsafe: OpenRouter's free-tier Free Models Router, tried once if the
# primary call above fails/times out or its spend cap is hit. Free key from
# https://openrouter.ai/keys. Also supported empty, same reasoning as above.
OPENROUTER_API_KEY=

# --- UN Comtrade (R2: register at https://comtradedeveloper.un.org/) ---
# Empty falls back to the committed bulk CSV extract.
COMTRADE_API_KEY=
