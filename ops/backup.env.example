# Copy to ops/backup.env on the VM. Gitignored: it names the bucket and where
# the passphrase lives, which is more than a public repo needs to say.

# The bucket gcp/02_backup_setup.sh created. Unset: the run stays on the VM and
# says so in the log.
BACKUP_BUCKET=<project-id>-backups

# Symmetric passphrase for config.tar.gz.gpg (.env files, TLS state, crontabs).
# Create it once with `openssl rand -base64 32 > ~/.ceynex-backup-passphrase`
# and `chmod 600` it, then store the same value in the team's password manager:
# a passphrase that exists only on the VM is lost with the disk it protects.
BACKUP_PASSPHRASE_FILE=/home/<vm-user>/.ceynex-backup-passphrase

# Defaults, shown for reference.
# CEYNEX_DIR=/home/<vm-user>/ceynex
# BACKUP_DIR=/home/<vm-user>/backups
# KEEP_LOCAL_DAYS=7
# WEEKLY_DAY=7
