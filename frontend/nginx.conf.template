# Templated by nginx:alpine's built-in entrypoint (envsubst on every file
# under /etc/nginx/templates/), which substitutes only the env vars actually
# set on the container -- nginx's own runtime variables ($host, $uri, etc.)
# are untouched since they were never in that list. BACKEND_INTERNAL_IP is
# set via docker-compose.yml's environment: block.

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    # Let's Encrypt cert for ceynex.cc + www.ceynex.cc. Renewal copies new
    # files over these two and runs `nginx -s reload`, so nothing here changes
    # -- see README.md's TLS section.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Drops the nginx version number from the Server header (ZAP 10036).
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # From a ZAP baseline scan, 2026-09-15 -- all "always" so they land on
    # error responses too, not just 200s. The two external hosts in
    # connect-src/style-src/font-src are real, checked against the source,
    # not guessed: index.css @imports Google Fonts (style-src/font-src) and
    # lib/passwordStrength.ts fetches the HIBP range API for the breach-check
    # meter (connect-src) -- a blanket 'self'-only policy would silently break
    # both. React's style={{...}} inline styles need style-src 'unsafe-inline'.
    # No inline <script> anywhere in index.html or the Vite build output, so
    # script-src stays 'self' with no unsafe-inline/eval.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.pwnedpasswords.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Same-origin API path -> backend VM, over the VPC. This is the only
    # thing that lets the browser reach a service with no public IP at all.
    #
    # proxy_pass has no path component here deliberately: with one, nginx
    # replaces the matched "/api/" prefix in the upstream request (so
    # /api/query would become /query). The backend's real routes live under
    # /api/ (verified against it directly: POST /api/query, not /query), so
    # the full original URI must pass through unchanged.
    location /api/ {
        proxy_pass http://${BACKEND_INTERNAL_IP}:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://${BACKEND_INTERNAL_IP}:8000/health;
    }

    # SPA fallback -- the app uses BrowserRouter (see src/App.tsx), so any
    # non-file path must resolve to index.html or client-side routes 404 on
    # refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
