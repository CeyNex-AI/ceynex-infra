# Copy to `.env`, fill in real values.

# Where nginx sends /api/ and /health. One VM (production): the API's container
# name, `ceynex-api`, over the shared `ceynex` network. Three VMs: the backend
# VM's internal IP — get with:
#   gcloud compute instances describe backend --zone=asia-south1-a \
#     --format='get(networkInterfaces[0].networkIP)'
BACKEND_INTERNAL_IP=10.x.x.x
